    <Routine name="Instructions_2"/>
    <Routine name="letter_practice"/>
    <LoopInitiator loopType="TrialHandler" name="practiceloop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'trial_number': 1, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'BAKER', 'middle_letter_category': 'A-M', 'probe_position': None, 'probe_display': None, 'correct_response': 'f'}, {'trial_number': 2, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'CLOUD', 'middle_letter_category': 'N-Z', 'probe_position': None, 'probe_display': None, 'correct_response': 'j'}, {'trial_number': 3, 'condition': 'letter', 'trial_type': 'probe', 'stimulus': 'TIGER', 'middle_letter_category': 'A-M', 'probe_position': 3, 'probe_display': '+ + 7 + +', 'correct_response': 'f'}, {'trial_number': 4, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'HAPPY', 'middle_letter_category': 'N-Z', 'probe_position': None, 'probe_display': None, 'correct_response': 'j'}, {'trial_number': 5, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'MOUSE', 'middle_letter_category': 'N-Z', 'probe_position': None, 'probe_display': None, 'correct_response': 'j'}, {'trial_number': 6, 'condition': 'letter', 'trial_type': 'probe', 'stimulus': 'CANDY', 'middle_letter_category': 'N-Z', 'probe_position': 1, 'probe_display': '7 + + + +', 'correct_response': 'j'}, {'trial_number': 7, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'LEMON', 'middle_letter_category': 'A-M', 'probe_position': None, 'probe_display': None, 'correct_response': 'f'}, {'trial_number': 8, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'RIVER', 'middle_letter_category': 'N-Z', 'probe_position': None, 'probe_display': None, 'correct_response': 'j'}, {'trial_number': 9, 'condition': 'letter', 'trial_type': 'probe', 'stimulus': 'HOUSE', 'middle_letter_category': 'N-Z', 'probe_position': 5, 'probe_display': '+ + + + 7', 'correct_response': 'j'}, {'trial_number': 10, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'TABLE', 'middle_letter_category': 'A-M', 'probe_position': None, 'probe_display': None, 'correct_response': 'f'}, {'trial_number': 11, 'condition': 'letter', 'trial_type': 'normal', 'stimulus': 'GREEN', 'middle_letter_category': 'A-M', 'probe_position': None, 'probe_display': None, 'correct_response': 'f'}, {'trial_number': 12, 'condition': 'letter', 'trial_type': 'probe', 'stimulus': 'PAPER', 'middle_letter_category': 'N-Z', 'probe_position': 2, 'probe_display': '+ 7 + + +', 'correct_response': 'j'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Downloads/LaBerge_Letter_Practice_ONLY.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="practiceloop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
