        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if (((stimulus !== null) &amp;&amp; (stimulus.toString().strip() !== &quot;&quot;))) {&amp;#10;    if ((condition === &quot;letter&quot;)) {&amp;#10;        middle_letter = stimulus.toString()[2].toUpperCase();&amp;#10;        if (((&quot;A&quot; &lt;= middle_letter) &amp;&amp; (middle_letter &lt;= &quot;M&quot;))) {&amp;#10;            correct_key = &quot;f&quot;;&amp;#10;        } else {&amp;#10;            correct_key = &quot;j&quot;;&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((condition === &quot;word&quot;)) {&amp;#10;            if ((category === &quot;word&quot;)) {&amp;#10;                correct_key = &quot;f&quot;;&amp;#10;            } else {&amp;#10;                correct_key = &quot;j&quot;;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if stimulus is not None and str(stimulus).strip() != &quot;&quot;:&amp;#10;    &amp;#10;    if condition == &quot;letter&quot;:&amp;#10;        middle_letter = str(stimulus)[2].upper()&amp;#10;&amp;#10;        if &quot;A&quot; &lt;= middle_letter &lt;= &quot;M&quot;:&amp;#10;            correct_key = &quot;f&quot;&amp;#10;        else:&amp;#10;            correct_key = &quot;j&quot;&amp;#10;&amp;#10;    elif condition == &quot;word&quot;:&amp;#10;        if category == &quot;word&quot;:&amp;#10;            correct_key = &quot;f&quot;&amp;#10;        else:&amp;#10;            correct_key = &quot;j&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
